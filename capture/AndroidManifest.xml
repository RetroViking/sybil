<?xml version="1.0" encoding="utf-8"?>
<!-- SIByL's Capture for a phone (see README.md, Capture from a phone): Capture opens over the lock screen too, as a
     camera does (showWhenLocked: all it can do is add to the Inbox), and from other apps' share sheets; Send waits for
     a network (a job asking for one needs ACCESS_NETWORK_STATE from Android 14 on: without it, scheduling threw, the
     app closing as it connected) and survives a restart (RECEIVE_BOOT_COMPLETED keeps its job); CaptureTile opens
     Capture from Quick Settings. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="sybil.capture" android:versionCode="7" android:versionName="7">
  <!-- Targeting Android 13, so the tile may start Capture itself when the phone is unlocked (see CaptureTile). -->
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <application android:label="Capture" android:icon="@mipmap/icon" android:allowBackup="false">
    <activity android:name=".Capture" android:exported="true" android:theme="@style/Capture" android:showWhenLocked="true"
      android:launchMode="singleTask" android:taskAffinity="" android:excludeFromRecents="true"
      android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
    <service android:name=".Send" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    <service android:name=".CaptureTile" android:exported="true" android:label="Capture" android:icon="@drawable/tray"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
  </application>
</manifest>
