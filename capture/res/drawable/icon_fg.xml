<?xml version="1.0" encoding="utf-8"?>
<!-- The icon's mark, centred in its 108 box at 1.6 times its 28 box: at icons/capture.svg's size (2.11) it filled most
     of what a launcher's mask shows (72 of the 108), its edges near the mask's and its shape hard to make out. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
  <group android:translateX="31.6" android:translateY="31.6" android:scaleX="1.6" android:scaleY="1.6">
    <path android:fillColor="#fff" android:fillType="evenOdd" android:pathData="@string/tray" />
    <path android:strokeColor="#fff" android:strokeWidth="1.22" android:strokeLineCap="round" android:pathData="@string/plus" />
  </group>
</vector>
